[Unit]
Description=AthanBox - apply the Security page (fail2ban, whitelist and blacklist)
# Started by azan-sip-security.path when the control panel saves a change, by the timer every
# minute (to keep the list of banned addresses fresh), and once at start-up.
After=network-online.target nftables.service fail2ban.service azan-sip-box.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
# The helper lives outside /opt/azan-sip, so the azan user can't change what runs as root
ExecStart=/usr/bin/python3 -I /usr/local/lib/azan-sip/security-helper.py apply /opt/azan-sip
WorkingDirectory=/
RuntimeDirectory=azan-sip-security
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
