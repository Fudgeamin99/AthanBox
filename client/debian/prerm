#!/bin/sh
set -e
if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
    systemctl disable --now azan-sip-client-screen azan-sip-client azan-sip-client-update.path azan-sip-client-shutdown.path \
        azan-sip-client-wifi.path >/dev/null 2>&1 || true
    systemctl start getty@tty1 >/dev/null 2>&1 || true
fi
exit 0
