#!/bin/sh
set -e
if [ "$1" = configure ]; then
    id azan-client >/dev/null 2>&1 \
        || useradd --system --user-group --create-home --home-dir /var/lib/azan-sip-client --shell /usr/sbin/nologin azan-client
    for group in video render input audio _seatd; do
        if getent group "$group" >/dev/null; then usermod -a -G "$group" azan-client; fi
    done
    mkdir -p /var/lib/azan-sip-client
    chown azan-client:azan-client /var/lib/azan-sip-client
    # A laptop keeps showing the prayer times with its lid closed, say with a TV plugged in
    # (from the next restart)
    if ls /proc/acpi/button/lid/*/state >/dev/null 2>&1; then
        mkdir -p /etc/systemd/logind.conf.d
        printf '[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n' \
            > /etc/systemd/logind.conf.d/azan-sip-client.conf
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable seatd >/dev/null 2>&1 || true
        systemctl start seatd >/dev/null 2>&1 || true
        systemctl enable azan-sip-client >/dev/null
        systemctl restart azan-sip-client
        # Update now in Screen settings
        systemctl enable azan-sip-client-update.path >/dev/null
        systemctl restart azan-sip-client-update.path
        # Shut down in Screen settings
        systemctl enable azan-sip-client-shutdown.path >/dev/null
        systemctl restart azan-sip-client-shutdown.path
        if systemctl is-enabled azan-sip-screen >/dev/null 2>&1; then
            systemctl disable azan-sip-client-screen >/dev/null 2>&1 || true
            echo "AthanBox's own screen is on here, so the client's screen isn't started."
            echo "To show another AthanBox's prayer times instead: sudo sh packaging/box/screen.sh off, then sudo systemctl enable --now azan-sip-client-screen"
        elif ls /dev/dri/card* >/dev/null 2>&1; then
            systemctl enable azan-sip-client-screen >/dev/null
            systemctl restart azan-sip-client-screen || true
        else
            echo "This computer has no screen output (no graphics found), so there is nothing to show the prayer times on."
        fi
    fi
    echo
    echo "AthanBox Client is installed. Choose AthanBox on the screen, or run:"
    echo "    azan-sip-client search             find AthanBoxes on the network"
    echo "    azan-sip-client connect <address>  show that AthanBox's prayer times here"
    echo "    azan-sip-client update             install a newer version (as root)"
    echo "Its settings also open from a phone or computer on the network, on port 8772: see Phones and computers in Screen settings."
    echo "On AthanBox, switch on \"Let TV screens connect\" on the TV app page."
fi
exit 0
