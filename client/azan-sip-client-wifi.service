[Unit]
Description=AthanBox Client - look for Wi-Fi networks, or join one, as Screen settings asked
# Started by azan-sip-client-wifi.path when Wi-Fi in Screen settings asks for it
StartLimitIntervalSec=0

[Service]
Type=oneshot
# As root, to change the Wi-Fi: with NetworkManager when it runs here, or else with ifupdown and
# wpa_supplicant (/etc/network/interfaces.d/azan-sip-client-wifi). It reads the request (made in
# the last two minutes) and deletes it, since it may hold the Wi-Fi's password. It never touches
# the network cable's settings. How it went is in /var/lib/azan-sip-client-power/wifi.json.
ExecStart=/usr/bin/python3 -I /usr/lib/azan-sip-client/azan_client.py wifi
WorkingDirectory=/
StateDirectory=azan-sip-client-power
TimeoutStartSec=300
