[Unit]
Description=AthanBox Client - shut down, restart or sleep for the night when Screen settings asks for it

[Path]
# The client (an unprivileged user) writes these files when Shut down or Restart is pressed in
# Screen settings, and as Night sleep begins
PathModified=/var/lib/azan-sip-client/shutdown-now
PathModified=/var/lib/azan-sip-client/restart-now
PathModified=/var/lib/azan-sip-client/sleep-now
Unit=azan-sip-client-shutdown.service

[Install]
WantedBy=multi-user.target
